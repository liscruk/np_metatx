#!/usr/bin/env python

import os
import sys
import re

from snakemake.utils import validate

# Old configs used hg38Seq/hg38Gtf/hg38Tx; point them at the new names instead of a schema error
if any(k in config for k in ("hg38Seq", "hg38Gtf", "hg38Tx")):
	sys.exit("Config keys hg38Seq/hg38Gtf/hg38Tx were renamed to hostSeq/hostGtf/hostTx. Please update your config.")

# Checks keys and types and fills defaults (threads, mode)
validate(config, "schemas/config.schema.yaml")

# Settings, paths, wildcard constraints and reference file checks
include: "rules/common.smk"

# Each branch defines its own target list (CANONICAL_TARGETS / NOVEL_TARGETS)
TARGETS = list()

if MODE in ("canonical", "both"):
	include: "rules/canonical.smk"
	TARGETS += CANONICAL_TARGETS

if MODE in ("novel", "both"):
	include: "rules/novel.smk"
	TARGETS += NOVEL_TARGETS

# Species composition (reads per species + ratio) for whichever branches run
include: "rules/species.smk"
TARGETS += SPECIES_TARGETS

# Read QC (seqkit), flagstat and the MultiQC report
include: "rules/qc.smk"
TARGETS += QC_TARGETS


# Prep output with rule all
rule all:
	default_target: True
	input:
		TARGETS

### Builds the hybrid references used by both branches.
### Inputs may be plain or gzipped. Genome contigs and GTF seqnames are prefixed with the
### species tag (e.g. hs_chr1, mm_chr1) because GENCODE human and mouse share contig names.
### Transcript IDs are left untouched (they are already species-specific).
rule makeRef:
	input:
		# Host reference fasta
		hr = HOST_SEQ,
		# Host reference annotation gtf
		ha = HOST_GTF,
		# Host reference transcriptome fasta
		hx = HOST_TX,
		# Xeno or pathogen genome fasta
		xr = XENO_SEQ,
		# Xeno or pathogen gtf NOT gff3
		xa = XENO_GTF,
		# Xeno or pathogen transcripts fasta
		xx = XENO_TX
	output:
		rHyb = HYB_GENOME,
		rFai = HYB_FAI,
		anHyb = HYB_GTF,
		txHyb = HYB_TX
	params:
		hs = SPECIES[0],
		xs = SPECIES[1]
	log:
		f"{LOGS}makeRef.log"
	benchmark:
		f"{BENCH}makeRef.tsv"
	conda:
		"envs/mapping.yaml"
	shell:"""
		dc() {{ case "$1" in *.gz) gzip -dc "$1" ;; *) cat "$1" ;; esac; }}
		pfa() {{ awk -v p="$1_" 'substr($0, 1, 1) == ">" {{$0 = ">" p substr($0, 2)}} 1'; }}
		pgtf() {{ awk -v p="$1_" 'BEGIN{{FS=OFS="\t"}} !/^#/{{$1 = p $1; print}}'; }}

		{{
		{{ dc {input.hr} | pfa {params.hs}; dc {input.xr} | pfa {params.xs}; }} > {output.rHyb}
		samtools faidx {output.rHyb}

		{{ dc {input.hx}; dc {input.xx}; }} > {output.txHyb}

		{{ dc {input.ha} | pgtf {params.hs}; dc {input.xa} | pgtf {params.xs}; }} > {output.anHyb}
		}} 2> {log}
	"""
